# Copy to .env and fill in. Never commit .env. All values below are placeholders.

# Hugging Face read token from an account approved for meta-llama/Llama-3.2-3B (official request, no mirrors).
# Only used once, to download weights into your Modal volume. Store it as a Modal secret named "huggingface".
HF_TOKEN=

# The Modal profile you want to bill. The backend refuses to run if the active profile differs.
TRIBE_MODAL_PROFILE=

# Hard monthly GPU cap in USD. Create it as a Modal secret: modal secret create tribe-config MONTHLY_BUDGET_CAP_USD=<n>
# Blank, 0 or unreadable means every run is refused.
MONTHLY_BUDGET_CAP_USD=

# Apify token, only for reel links that cannot be downloaded without a login (public reels only).
APIFY_TOKEN=

# Optional: your own Vercel team or user slug, used by the media helper for Blob commands.
TRIBE_VERCEL_SCOPE=

# Optional: folder of your own notes the strategist may read (read-only). Leave empty for none.
TRIBE_VAULT_DIR=

# Dashboard (web/): "fixtures" (default, synthetic data) or "db"
TRIBE_DATA_SOURCE=

# Dashboard database roles (Neon Postgres). Three separate roles on purpose.
TRIBE_WEB_DATABASE_URL=
TRIBE_RUNNER_DATABASE_URL=
TRIBE_OWNER_DATABASE_URL=

# Upstash Redis (REST). Vercel Marketplace names (KV_REST_API_*) also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob, only for private reel video copies
BLOB_READ_WRITE_TOKEN=

# Only if your analysis layer calls Claude directly
ANTHROPIC_API_KEY=
