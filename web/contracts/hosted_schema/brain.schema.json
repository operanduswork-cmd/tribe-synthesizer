{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:tribe:hosted:brain:v1",
 "title": "Tribe hosted page: brain",
 "description": "One TRIBE job's brain view (D28), keyed by job id like its tribe page: the predicted average-brain response per second on the fsaverage5 surface, area means and the keys of the binary assets (web/contracts/brain-assets.json). Frames are int8 on ONE colour scale for the whole reel (scale.vmax = p99 of |model output| over every cortex vertex and every second; value = q / 127 * vmax) and are unsmoothed 1-s rows, as are the area and line means here (the tribe page's lines are smoothed). Area means are the signed mean of the model output over each area's vertices, 4 dp, listed in atlas.hcp.labels order (Glasser index) per side; Yeo-7 means take both sides; areas.lines are the four lines' per-second means over the masks-v1 vertices. Show areas in atlas.order (Yeo network, then Glasser index), never sorted by a value, never compared with another reel (D21). Atlas names mark places on the cortex, not feelings or functions. assets: sha256 of the stored gzip bytes (brain_assets.hash), bytes = the decompressed length (brain_assets.raw_bytes). No words, no counts, no per-vertex floats.",
 "x-kind": "brain",
 "x-key": "^\\d{8}-\\d{6}-[0-9a-f]{8}$",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "v",
  "job_id",
  "shortcode",
  "framing",
  "masks_version",
  "precision",
  "time_s",
  "scale",
  "frames",
  "mesh",
  "atlas",
  "areas"
 ],
 "properties": {
  "v": {
   "type": "integer",
   "const": 1
  },
  "job_id": {
   "$ref": "#/$defs/job_id",
   "x-layer": "ui"
  },
  "shortcode": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "$ref": "#/$defs/shortcode"
    }
   ]
  },
  "framing": {
   "type": "string",
   "const": "predicted average-brain response",
   "x-layer": "brain"
  },
  "masks_version": {
   "type": "string",
   "pattern": "^masks-v\\d{1,3}$"
  },
  "precision": {
   "type": [
    "string",
    "null"
   ],
   "enum": [
    "fp32",
    "bf16",
    null
   ]
  },
  "time_s": {
   "type": "array",
   "items": {
    "type": "number",
    "minimum": 0,
    "maximum": 3600
   },
   "minItems": 1,
   "maxItems": 90
  },
  "scale": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "mode",
    "label",
    "vmax",
    "percentile",
    "pooled",
    "levels",
    "colormap",
    "grey_below",
    "full_at",
    "clipped_share"
   ],
   "properties": {
    "mode": {
     "type": "string",
     "const": "within-reel"
    },
    "label": {
     "type": "string",
     "const": "one colour scale for this whole reel",
     "x-layer": "brain"
    },
    "vmax": {
     "type": "number",
     "exclusiveMinimum": 0,
     "maximum": 10
    },
    "percentile": {
     "type": "integer",
     "const": 99
    },
    "pooled": {
     "type": "string",
     "const": "every cortex vertex, every second"
    },
    "levels": {
     "type": "integer",
     "const": 127
    },
    "colormap": {
     "type": "string",
     "const": "PuOr_r"
    },
    "grey_below": {
     "type": "number",
     "const": 0.15
    },
    "full_at": {
     "type": "number",
     "const": 0.5
    },
    "clipped_share": {
     "type": "number",
     "minimum": 0,
     "maximum": 0.05
    }
   }
  },
  "frames": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key",
    "sha256",
    "bytes"
   ],
   "properties": {
    "key": {
     "type": "string",
     "pattern": "^tribe/\\d{8}-\\d{6}-[0-9a-f]{8}/frames\\.i8$"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
     "type": "integer",
     "minimum": 16,
     "maximum": 4194304
    }
   }
  },
  "mesh": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key",
    "sha256",
    "bytes"
   ],
   "properties": {
    "key": {
     "type": "string",
     "pattern": "^shared/fsaverage5-inflated-v\\d{1,3}\\.bin$"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
     "type": "integer",
     "minimum": 16,
     "maximum": 4194304
    }
   }
  },
  "atlas": {
