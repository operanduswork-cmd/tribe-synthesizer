{
 "v": 1,
 "description": "The allow-list of job kinds the site may queue and the laptop runner may run (D26). Instagram only. The runner re-checks every argument and every limit; the site only offers what is enabled here.",
 "platform": "instagram",
 "limits": {
  "description": "Enforced by the runner (strategist/jobs.py), shown by the site. Never raised from the site.",
  "paid_running_max": 1,
  "paid_usd_per_day": 1.0,
  "paid_jobs_per_day": 10,
  "tribe_reads_per_month": 4,
  "confirm_expires_min": 30,
  "modal_cap_usd": 30.0,
  "apify_cap_usd": 4.5
 },
 "defs": {
  "shortcode": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_-]{5,20}$",
   "description": "An Instagram reel shortcode. The runner builds the URL itself."
  },
  "handle": {
   "type": "string",
   "pattern": "^@?[A-Za-z0-9._]{1,30}$",
   "description": "An Instagram handle, as strategist.store.check_handle accepts it (one leading @ allowed)."
  },
  "draft_id": {
   "type": "string",
   "pattern": "^\\d{8}-[A-Za-z0-9][A-Za-z0-9-]{1,60}$",
   "description": "A draft id, as strategist.lab ID_RE."
  },
  "slug": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{1,60}$",
   "description": "A new draft's slug, as strategist.lab SLUG_RE."
  },
  "pattern_id": {
   "type": "string",
   "pattern": "^(hook|structure|cta|format)\\.(caption|spoken)\\.[a-z0-9-]{1,80}$"
  },
  "variant_id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_-]{1,20}$"
  },
  "field_accept": {
   "type": "string",
   "pattern": "^(all|(hook_shape|format|cta|beats)(\\.[0-9]{1,2})?)$",
   "description": "A shape field, as strategist.reel FIELD_RE, or all."
  },
  "field_reject": {
   "type": "string",
   "pattern": "^(hook_shape|format|cta|beats)(\\.[0-9]{1,2})?$",
   "description": "One shape field at a time (reject takes no all)."
  },
  "label_status": {
   "type": "string",
   "enum": [
    "accepted",
    "rejected"
   ]
  },
  "reason": {
   "type": "string",
   "minLength": 1,
   "maxLength": 200,
   "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
   "description": "A discount reason: one line, no control characters."
  },
  "coach_text": {
   "type": "string",
   "minLength": 1,
   "maxLength": 500,
   "pattern": "^[^\\u0000-\\u0009\\u000B-\\u001F\\u007F]+$",
   "description": "Free text for the coach: newlines allowed, no other control characters. It is passed as data, never as a command."
  }
 },
